# Copie para .env e preencha. O .env não vai pro GitHub.

# Banco de dados (sem DB_URL, usa o MySQL local: jdbc:mysql://localhost:3306/duvidasdb)
# Para usar o Aiven, descomente e preencha:
# DB_URL=jdbc:mysql://HOST:PORTA/duvidasdb?sslMode=REQUIRED
DB_USER=root
DB_PASSWORD=

# Chaves de acesso (gere cada uma com: openssl rand -hex 24)
API_KEY_ALUNO=
API_KEY_PROFESSOR=

# Opcional: sites liberados no navegador (padrão: qualquer porta em localhost/127.0.0.1)
# CORS_ORIGENS=http://localhost:*,http://127.0.0.1:*,https://*.github.io,https://*.vercel.app
